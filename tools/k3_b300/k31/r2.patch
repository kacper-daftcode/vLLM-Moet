+"""The DSpark drafter's context-KV insert in one launch.
+
+``K3DSparkModel._precompute_fused_context_kv`` (dspark_mla.py) follows the
+``context_kv_proj`` GEMM ([R * (k + 1), 5 * 576] BF16, every draft layer's
+``kv_a_proj_with_mqa`` stacked) with six launches per step on the step's critical
+path (trace of 2026-11-05, offsets 187.9-200.6 us: 12.7 us for 4 rows x 5 layers):
+
+  permute(1, 0, 2).contiguous() of the latents          at::native elementwise 2.9 us
+  grouped kv_a_layernorm (ops.rms_norm, 2-D weights)    rms_norm 2.7
+  permute(1, 0, 2).contiguous() of k_pe                 elementwise 2.5
+  positions repeated per layer (copy_)                  elementwise 1.8
+  RoPE of k_pe (ops.rotary_embedding, interleaved)      rotary_embedding 1.8
+  FP8 quantization + paged insert of every layer        concat_and_cache_mla_grouped 1.5
+
+``store_context_kv`` does the same work in one Triton launch, one program per
+(layer, context token), reading the GEMM output in place ([R', 5, 576]: no
+permutes, no repeated positions): RMSNorm of the 512 latents with layer ``l``'s
+``kv_a_layernorm`` weight (FP32 sum of squares, ``rsqrt(var + eps)``,
+``x * rstd * w`` rounded once to BF16: the grouped ``rms_norm`` op's order), RoPE
+of the 64 ``k_pe`` values from the FP32 cos/sin table at the token's position
+(interleaved pairs, ``x cos - y sin`` / ``y cos + x sin`` in FP32, rounded to
+BF16: ``rotary_embedding`` non-neox), then ``fp8(x / k_scale[l])`` (IEEE division,
+saturating E4M3: ``scaled_convert``) of the 576 bytes into layer ``l``'s paged
+cache at ``slot_mapping[l, t]`` (``PAD_SLOT_ID`` < 0 skips the row). Everything
+else (which rows, which slots, the GEMM) is unchanged.
+
+Precision: bit-identical cache bytes to the stock chain with random data at the
+real shapes (every stage was bisected against its vLLM op); GPU time 10.5 ->
+2.2 us per step under a graph.
+
+Served when every draft layer's cache is a plain per-tensor FP8 one ("fp8" /
+"fp8_e4m3": ``_context_kv_scales`` set) with one block layout, the latent
+geometry is 512 + 64 and the rotary table is FP32 with 64 columns; anything else
+keeps the stock chain (the caller runs ``super()``).
+"""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+LORA, ROPE = 512, 64
+WIDTH = LORA + ROPE
+# The kernel's compile-time copies (Triton reads globals only as tl.constexpr).
+_LORA, _ROPE, _HALF, _WIDTH = (tl.constexpr(v) for v in (LORA, ROPE, ROPE // 2, WIDTH))
+
+
+@triton.jit
+def _context_kv_kernel(
+    kv_ptr,  # [T, L, 576] BF16 (the context_kv_proj output, row-major)
+    kv_row_stride,  # elements per token row (L * 576)
+    norm_w_ptr,  # [L, 512] BF16
+    pos_ptr,  # [T] int64
+    cos_sin_ptr,  # [max_pos, 64] FP32: cos(32) | sin(32)
+    slot_ptr,  # [L, T] int64 (slot_stride 0 broadcasts one row)
+    slot_stride,
+    cache_ptrs,  # [L] int64: each layer's cache base (uint8 elements)
+    scales_ptr,  # [L] FP32: k_scale per layer
+    block_size,
+    block_stride,
+    entry_stride,
+    eps,
+    T,
+    LAYERS: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    layer = pid // T
+    token = pid % T
+    slot = tl.load(slot_ptr + layer * slot_stride + token)
+    if slot >= 0:
+        base = kv_ptr + token.to(tl.int64) * kv_row_stride + layer * _WIDTH
+        # -- RMSNorm of the latent (the grouped rms_norm op: fp32 variance,
+        #    rsqrt(var / n + eps), one BF16 rounding of x * rstd * w; measured
+        #    bit-identical to ops.rms_norm with 2-D weights, see the test) --
+        cols = tl.arange(0, _LORA)
+        x = tl.load(base + cols).to(tl.float32)
+        var = tl.sum(x * x, axis=0) / _LORA
+        rstd = tl.rsqrt(var + eps)
+        w = tl.load(norm_w_ptr + layer * _LORA + cols).to(tl.float32)
+        normed = (x * rstd * w).to(tl.bfloat16)
+        # -- RoPE of k_pe, interleaved pairs (rotary_embedding, is_neox False) --
+        half = tl.arange(0, _HALF)
+        pos = tl.load(pos_ptr + token)
+        cos = tl.load(cos_sin_ptr + pos * _ROPE + half)
+        sin = tl.load(cos_sin_ptr + pos * _ROPE + _HALF + half)
+        px = tl.load(base + _LORA + 2 * half).to(tl.float32)
+        py = tl.load(base + _LORA + 2 * half + 1).to(tl.float32)
+        rx = (px * cos - py * sin).to(tl.bfloat16)
+        ry = (py * cos + px * sin).to(tl.bfloat16)
+        # -- fp8(x / scale) into the paged cache (concat_and_cache_mla, scaled) --
+        scale = tl.load(scales_ptr + layer)
+        cache = tl.load(cache_ptrs + layer).to(tl.pointer_type(tl.float8e4nv))
+        block = slot // block_size
+        offset = slot % block_size
+        dst = cache + block * block_stride + offset * entry_stride
+        q_lat = tl.math.div_rn(normed.to(tl.float32), scale).to(tl.float8e4nv)
+        tl.store(dst + cols, q_lat)
+        q_x = tl.math.div_rn(rx.to(tl.float32), scale).to(tl.float8e4nv)
+        q_y = tl.math.div_rn(ry.to(tl.float32), scale).to(tl.float8e4nv)
+        tl.store(dst + _LORA + 2 * half, q_x)
+        tl.store(dst + _LORA + 2 * half + 1, q_y)
+
+
+def store_context_kv(
+    all_kv: torch.Tensor,
+    norm_weights: torch.Tensor,
+    positions: torch.Tensor,
+    cos_sin_cache: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    cache_ptrs: torch.Tensor,
+    k_scales: torch.Tensor,
+    block_size: int,
+    block_stride: int,
+    entry_stride: int,
+    eps: float,
+) -> None:
+    """One launch: norm + RoPE + FP8 quant + paged insert of ``all_kv``
+    ([T, L, 576] BF16, the GEMM output in place) into the ``L`` layers' caches.
+    ``slot_mapping``: [L, T] int64, or [T] shared by every layer."""
+    tokens, layers, width = all_kv.shape
+    assert width == WIDTH and all_kv.stride(2) == 1 and all_kv.stride(1) == WIDTH
+    assert norm_weights.shape == (layers, LORA) and norm_weights.is_contiguous()
+    assert cos_sin_cache.dtype == torch.float32 and cos_sin_cache.shape[1] == ROPE
+    assert cos_sin_cache.is_contiguous() and positions.dtype == torch.int64
+    assert k_scales.dtype == torch.float32 and k_scales.numel() == layers
+    assert cache_ptrs.dtype == torch.int64 and cache_ptrs.numel() == layers
+    if slot_mapping.dim() == 1:
+        slot_stride = 0
+    else:
+        assert slot_mapping.shape == (layers, tokens)
+        slot_mapping = slot_mapping.contiguous()
+        slot_stride = slot_mapping.stride(0)
+    assert slot_mapping.dtype == torch.int64
+    if tokens == 0:
+        return
+    _context_kv_kernel[(layers * tokens,)](
+        all_kv,
+        all_kv.stride(0),
+        norm_weights,
+        positions,
+        cos_sin_cache,
+        slot_mapping,
+        slot_stride,
+        cache_ptrs,
+        k_scales,
+        block_size,
+        block_stride,
+        entry_stride,
+        eps,
+        tokens,
+        LAYERS=layers,
+        num_warps=4,
+    )
+
+
+def eligible(backbone) -> bool:
+    """Whether ``precompute_context_kv`` serves this drafter: plain per-tensor FP8
+    caches (the grouped scales exist), one block layout, 512 + 64 latents, an FP32
+    64-column rotary table (``_build_fused_context_kv_metadata`` has run)."""
+    if getattr(backbone, "_context_kv_scales", None) is None:
+        return False
+    layers = [layer.self_attn for layer in backbone.layers]
+    if any(a.kv_cache_dtype not in ("fp8", "fp8_e4m3") for a in layers):
+        return False
+    if backbone._context_kv_lora_rank != LORA or backbone._context_rope_dim != ROPE:
+        return False
+    rotary = layers[0].rotary_emb
+    if rotary is None or rotary.cos_sin_cache.dtype != torch.float32:
+        return False
+    if rotary.cos_sin_cache.shape[1] != ROPE or rotary.is_neox_style:
+        return False
+    return all(a.kv_cache.numel() > 0 and a.kv_cache.dtype == torch.uint8 for a in layers)
+
+
+def precompute_context_kv(backbone, context_states, context_positions, slots) -> bool:
+    """``K3DSparkModel.precompute_and_store_context_kv`` with the post-GEMM chain
+    fused (``store_context_kv``); False when this batch keeps the stock chain
+    (no slots to write, a mixed slot layout, a cache this does not serve)."""
+    if slots is None:
+        return False
+    if not hasattr(backbone, "_num_context_layers"):
+        backbone._build_fused_context_kv_metadata()
+    # Eligibility is decided once the caches are bound (the memory profile runs
+    # on unbound placeholder caches: stock chain); a True verdict is final.
+    if not getattr(backbone, "_context_kv_fused_ok", False):
+        if not eligible(backbone):
+            return False
+        backbone._context_kv_fused_ok = True
+    layers = [layer.self_attn for layer in backbone.layers]
+    if not backbone._has_uniform_block_layout(layers):
+        return False
+    num_layers = backbone._num_context_layers
+    if isinstance(slots, (list, tuple)):
+        rows = [s for s in slots if s is not None]
+        if len(rows) != num_layers:
+            return False
+        if len({s.data_ptr() for s in rows}) == 1:
+            slot_mapping = rows[0]
+        else:
+            slot_mapping = torch.stack(rows, dim=0)
+    else:
+        slot_mapping = slots
+    if slot_mapping.dtype != torch.int64:
+        return False
+    all_kv = backbone.context_kv_proj(context_states)
+    tokens = context_states.shape[0]
+    all_kv = all_kv.view(tokens, num_layers, WIDTH)
+    ref = layers[0].kv_cache
+    store_context_kv(
+        all_kv,
+        backbone._context_kv_norm_weights,
+        context_positions,
+        layers[0].rotary_emb.cos_sin_cache,
+        slot_mapping,
+        backbone._get_context_kv_cache_ptrs(layers),
+        backbone._context_kv_scales,
+        ref.size(1),
+        ref.stride(0),
+        ref.stride(1),
+        backbone._context_rms_norm_eps,
+    )
+    return True
