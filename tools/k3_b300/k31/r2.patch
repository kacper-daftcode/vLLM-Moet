+# [vllm-moet] SwiGLU epilogue (``swiglu``): the weight's rows are interleaved in
+# groups of SWIGLU_GROUP (gate rows 8b..8b+7, then up rows 8b..8b+7, ...; see
+# swiglu_permute), so within one output tile the lane holding feature f and the
+# lane holding feature f + 8 of the same token hold a (gate, up) pair, whatever the
+# output tile (16 or 32). The gate lane writes silu(g) * u into an [M, N / 2]
+# output, as vLLM's SiluAndMul does from the BF16 GEMM output: g and u rounded to
+# BF16, silu(g) = g / (1 + exp(-g)) in FP32 rounded to BF16, the product rounded
+# to BF16. Everything before the epilogue is the unchanged kernel.
+SWIGLU_GROUP = 8
+
+
+def swiglu_permute(weight):
+    """The [2 * I, K] gate_up weight (gate rows, then up rows) in the row order the
+    ``swiglu`` epilogue reads: groups of SWIGLU_GROUP gate rows alternating with
+    the matching up rows. A copy; ``I`` must be a multiple of SWIGLU_GROUP."""
+    n, k = weight.shape
+    inter = n // 2
+    assert n % (2 * SWIGLU_GROUP) == 0, weight.shape
+    return (
+        weight.view(2, inter // SWIGLU_GROUP, SWIGLU_GROUP, k)
+        .permute(1, 0, 2, 3)
+        .reshape(n, k)
+        .contiguous()
+    )
+
+
+def swiglu_unpermute_columns(gate_up):
+    """The columns of a GEMM output computed with a ``swiglu_permute``d weight back
+    in the stock [gate | up] order (a copy): the stock SiluAndMul can follow."""
+    m, n = gate_up.shape
+    inter = n // 2
+    return (
+        gate_up.view(m, inter // SWIGLU_GROUP, 2, SWIGLU_GROUP)
+        .permute(0, 2, 1, 3)
+        .reshape(m, n)
+    )
+
