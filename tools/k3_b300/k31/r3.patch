+            # post-step gather (allocated at the eager warmup, before capture)
+            self.shard_cache = torch.zeros(
+                self.max_rows, n_spec, self.shard, dtype=base_shard.dtype,
+                device=self.device,
+            )
+        for step in range(n_spec):
+            self.run_step(spec, num_reqs, base_shard, w1, step)
+        self.finish(spec, num_reqs, n_spec, cache)
