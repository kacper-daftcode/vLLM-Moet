+def slice_w2(w2, voff, shard):
+    """[vllm-moet r3] This rank's rows of markov_w2: ``w2[voff : voff + shard]``,
+    zero-padded to ``shard`` rows past the vocabulary (the last rank of a padded
+    vocabulary), contiguous."""
+    end = min(voff + shard, w2.shape[0])
+    rows = w2[voff:end]
+    if rows.shape[0] == shard:
+        return rows.contiguous()
+    out = torch.zeros(shard, w2.shape[1], dtype=w2.dtype, device=w2.device)
+    out[: rows.shape[0]].copy_(rows)
+    return out
+
+
+def shard_layout(model):
+    """[vllm-moet r3] (tp, rank, S, V) of the lm_head's vocab-parallel layout when
+    it is the plain contiguous one the shard needs (rank d owns padded-vocab rows
+    [d S, (d + 1) S), which the logits gather lays out in rank order), else None."""
+    head = model.lm_head
+    lp = model.logits_processor
+    tp = getattr(head, "tp_size", 1)
+    if tp <= 1:
+        return None
+    idx = getattr(head, "shard_indices", None)
+    if idx is None or head.weight.dim() != 2:
+        return None
+    S = head.weight.shape[0]
+    V = lp.org_vocab_size
+    rank = idx.org_vocab_start_index // S if S else -1
+    if (
+        S * tp != head.num_embeddings_padded
+        or idx.org_vocab_start_index != rank * S
+        or idx.org_vocab_end_index != min(rank * S + S, V)
+        or idx.added_vocab_start_index != idx.added_vocab_end_index
+        or idx.num_org_elements_padded != S
+        or not 0 <= rank < tp
+    ):
+        return None
+    return tp, rank, S, V
+
+
+def why_not_sharded(spec, model, num_reqs, comm):
+    """[vllm-moet r3] Why this draft step takes the replicated fused path instead
+    of the vocab-sharded one, or None."""
+    if not MARKOV_SHARD:
+        return "VLLM_MOET_MARKOV_SHARD=0"
+    if comm is None or comm.logits is None:
+        return "no drafter mailbox"
+    if spec.use_fp64_gumbel:
+        return "FP64 Gumbel keys"
+    if spec.draft_logits.values.dtype != torch.bfloat16:
+        return f"{spec.draft_logits.values.dtype} draft logits cache (the mailbox gather is BF16)"
+    layout = shard_layout(model)
+    if layout is None:
+        return "lm_head layout"
+    tp, rank, S, V = layout
+    if tp != comm.tp or rank != comm.rank or S != comm.vocab_shard:
+        return "lm_head shard differs from the mailbox's"
+    w2 = model.model.markov_head.markov_w2.weight
+    if w2.shape[0] != V:
+        return "markov_w2 vocabulary differs from the lm_head's"
+    k = spec.num_speculative_steps
+    from .comm import EXCHANGE_STEPS, ROWS_CAP
+
+    if k > EXCHANGE_STEPS:
+        return f"k {k} > exchange slots {EXCHANGE_STEPS}"
+    if num_reqs > ROWS_CAP or num_reqs * k > ROWS_CAP:
+        return f"{num_reqs} x {k} rows > mailbox cap {ROWS_CAP}"
+    return None
+
+
+_SHARDED: dict = {}
+
+
+def _sharded(spec, model, comm, w2, device):
+    tp, rank, S, V = shard_layout(model)
+    key = (device, V, w2.shape[1], S)
+    inst = _SHARDED.get(key)
+    if inst is None or inst.max_rows < spec.max_num_reqs:
+        from .comm import EXCHANGE_STEPS
+
+        # the load-time shard (``prepare_sharded``), else sliced now (eager warmup)
+        shard_w2 = getattr(model, "_markov_w2_shard", None)
+        if shard_w2 is None or shard_w2.shape != (S, w2.shape[1]) or shard_w2.dtype != w2.dtype:
+            shard_w2 = w2
+        inst = ShardedMarkov(
+            V, w2.shape[1], spec.max_num_reqs, EXCHANGE_STEPS, device, comm, shard_w2,
+            tp, rank, S,
+        )
+        _SHARDED[key] = inst
+        logger.info_once(
+            "DSpark vocab-sharded Markov sampling: rank %d of %d owns tokens %d..%d "
+            "(%d valid), %d programs x %d tiles of %d, fused select %s",
+            rank, tp, inst.voff, inst.voff + S, inst.vocab_local, inst.nb, inst.tpc,
+            inst.vt, inst.fused_select,
+        )
+    return inst
+
