+# [vllm-moet r3] ``prepare_pos_seq_lens`` + ``combine_sampled_and_draft_tokens`` in
+# one launch: both are one program per request, and the second only needs the
+# first's ``seq_len`` of the same request (computed here instead of re-read), so
+# the fused program writes the request's positions, its seq_len, its logits
+# indices and its sampled / draft input ids; the extra program pads seq_lens as
+# before. Same stores, same values, same order within a request.
+@triton.jit
+def _prepare_pos_and_combine_kernel(
+    pos_ptr,
+    seq_lens_ptr,
+    idx_mapping_ptr,
+    query_start_loc_ptr,
+    num_computed_tokens_ptr,
+    max_num_reqs,
+    input_ids_ptr,
+    last_sampled_tokens_ptr,
+    prefill_len_ptr,
+    draft_tokens_ptr,
+    draft_tokens_stride,
+    cu_num_logits_ptr,
+    logits_indices_ptr,
+    POS_BLOCK: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+    NUM_NEW_SAMPLED_TOKENS: tl.constexpr = 1,
+):
+    batch_idx = tl.program_id(0)
+    num_reqs = tl.num_programs(0) - 1
+    if batch_idx == num_reqs:
+        # Pad unused seq_lens as 0 for full CUDA graphs.
+        for i in tl.range(num_reqs, max_num_reqs, POS_BLOCK):
+            block = i + tl.arange(0, POS_BLOCK)
+            mask = block < max_num_reqs
+            tl.store(seq_lens_ptr + block, 0, mask=mask)
+        return
+
+    req_state_idx = tl.load(idx_mapping_ptr + batch_idx)
+    num_computed_tokens = tl.load(num_computed_tokens_ptr + req_state_idx)
+    start = tl.load(query_start_loc_ptr + batch_idx)
+    query_end = tl.load(query_start_loc_ptr + batch_idx + 1)
+    query_len = query_end - start
+    seq_len = num_computed_tokens + query_len
+    tl.store(seq_lens_ptr + batch_idx, seq_len)
+    for i in tl.range(0, query_len, POS_BLOCK):
+        block = i + tl.arange(0, POS_BLOCK)
+        mask = block < query_len
+        tl.store(pos_ptr + start + block, num_computed_tokens + block, mask=mask)
+
+    # ``_combine_sampled_and_draft_tokens_kernel`` with seq_len from above.
+    cu_num_logits_start = tl.load(cu_num_logits_ptr + batch_idx)
+    cu_num_logits_end = tl.load(cu_num_logits_ptr + batch_idx + 1)
+    num_logits = cu_num_logits_end - cu_num_logits_start
+    num_draft_tokens = num_logits - NUM_NEW_SAMPLED_TOKENS
+    block = tl.arange(0, BLOCK_SIZE)
+    logits_start = query_end - num_logits
+    tl.store(
+        logits_indices_ptr + cu_num_logits_start + block,
+        logits_start + block,
+        mask=block < num_logits,
+    )
+    prefill_len = tl.load(prefill_len_ptr + req_state_idx)
+    if seq_len <= prefill_len:
+        return
+    first_logit_seq_pos = seq_len - num_logits
+    if NUM_NEW_SAMPLED_TOKENS > 0 and first_logit_seq_pos >= prefill_len:
+        last_token_id = tl.load(last_sampled_tokens_ptr + req_state_idx)
+        tl.store(input_ids_ptr + logits_start, last_token_id)
+    if num_draft_tokens > 0:
+        mask = block < num_draft_tokens
+        draft_tokens = tl.load(
+            draft_tokens_ptr + req_state_idx * draft_tokens_stride + block,
+            mask=mask,
+        )
+        tl.store(
+            input_ids_ptr + query_end - num_draft_tokens + block,
+            draft_tokens,
+            mask=mask,
+        )
+
+
+def prepare_pos_seq_lens_and_combine(
+    idx_mapping: torch.Tensor,
+    query_start_loc: torch.Tensor,
+    num_computed_tokens: torch.Tensor,
+    pos: torch.Tensor,
+    seq_lens: torch.Tensor,
+    input_ids: torch.Tensor,
+    last_sampled_tokens: torch.Tensor,
+    prefill_len: torch.Tensor,
+    draft_tokens: torch.Tensor,
+    cu_num_logits: torch.Tensor,
+    num_logits: int,
+    num_new_sampled_tokens: int = 1,
