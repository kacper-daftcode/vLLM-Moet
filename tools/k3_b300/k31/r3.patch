+                out_arg,
+                self.dummy,  # noise (unused: NOISE=False)
+                0,
+                0,
+                self.dummy,  # tokens_ptr (unused: SHARD)
+                0,
+                self.counter,
+                exch_prev,
+                exch_prev.stride(0),
+                self.pack,
+                self.voff,
+                self.tp_rank,
+                num_reqs,
+                self.vocab_local,
+                self.nb,
+                STEP=step,
+                RANK=self.rank,
+                VT=self.vt,
+                TPC=self.tpc,
+                RB=rb,
+                USE_FP64=False,
+                SALT=_DRAFT_NOISE_SALT,
+                NOISE=False,
+                PDL=self.pdl,
+                SELECT=self.fused_select,
+                NB_POW2=self.nb_pow2,
+                NR=num_reqs if num_reqs <= self.small_rows else 0,
+                SHARD=True,
+                TP=self.tp,
+                TP_POW2=self.tp_pow2,
