+    _prepare_pos_and_combine_kernel[(num_reqs + 1,)](
+        pos,
+        seq_lens,
+        idx_mapping,
+        query_start_loc,
+        num_computed_tokens,
+        seq_lens.shape[0],
+        input_ids,
+        last_sampled_tokens,
+        prefill_len,
+        draft_tokens,
+        draft_tokens.stride(0),
+        cu_num_logits,
+        logits_indices,
+        POS_BLOCK=1024,
+        BLOCK_SIZE=triton.next_power_of_2(num_speculative_steps + num_new_sampled_tokens),
+        NUM_NEW_SAMPLED_TOKENS=num_new_sampled_tokens,
+    )
+    return logits_indices
+
