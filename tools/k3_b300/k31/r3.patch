+            torch.empty(max_rows, self.nb, dtype=torch.float32, device=device),
+            torch.empty(max_rows, self.nb, dtype=torch.int64, device=device),
+        )
+        self.counter = torch.zeros(
+            triton.cdiv(max_rows, RB), dtype=torch.int32, device=device
+        )
+        self.pack = torch.zeros(max_rows, 4, dtype=torch.int32, device=device)
+        self.exch = torch.zeros(k_max, max_rows, 4 * tp, dtype=torch.int32, device=device)
+        self.shard_cache = None  # [max_rows, k_max, S] at the first run (its dtype)
+        self.max_rows, self.k_max, self.device = max_rows, k_max, device
+        self.dummy = torch.zeros(1, dtype=torch.int64, device=device)
+
+    def run(self, spec, num_reqs, base_shard, w1, cache):
+        """``base_shard``: [num_reqs, k, S] this rank's lm_head logits shard (BF16 /
+        FP32, the cache's dtype); writes ``spec.draft_tokens[:num_reqs]`` and the
+        k rows of every request in ``cache`` (the draft logits cache values)."""
+        n_spec = base_shard.shape[1]
