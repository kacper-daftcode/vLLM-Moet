+def prepare_sharded(model) -> str:
+    """[vllm-moet r3] Build the rank's markov_w2 shard at load (``model.py``
+    ``after_loading``), so its memory precedes the KV-cache profile; returns a
+    log string. The speculator-sized scratch follows at the first draft step."""
+    comm = getattr(model, "_drafter_comm", None)
+    if not MARKOV_SHARD:
+        return "off (VLLM_MOET_MARKOV_SHARD=0)"
+    if comm is None or comm.logits is None:
+        return "off (no mailbox)"
+    layout = shard_layout(model)
+    if layout is None:
+        return "off (lm_head layout)"
+    tp, rank, S, V = layout
+    w2 = model.model.markov_head.markov_w2.weight
+    if w2.dtype != torch.bfloat16 or w2.shape[0] != V:
+        return "off (markov_w2 shape / dtype)"
+    model._markov_w2_shard = slice_w2(w2, rank * S, S)
+    return f"rank {rank}/{tp} tokens {rank * S}..{rank * S + S} ({S * w2.shape[1] * 2 / 2**20:.0f} MiB)"
 
 
