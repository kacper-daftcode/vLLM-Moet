+        self.vocab_local = max(0, min(vocab - self.voff, shard))
+        sms = torch.cuda.get_device_properties(device).multi_processor_count
+        self.vt = VT
+        self.stages = SHARD_STAGES if stages is None else stages
+        self.num_warps = NUM_WARPS if num_warps is None else num_warps
+        self.small_rows = SMALL_ROWS if small_rows is None else small_rows
+        self.fused_select = SHARD_FUSED_SELECT if fused_select is None else fused_select
+        self.pdl = _pdl_supported(device) if pdl is None else pdl
+        tiles = triton.cdiv(max(self.vocab_local, 1), self.vt)
+        ctas = SHARD_CTAS_PER_SM if ctas_per_sm is None else ctas_per_sm
+        self.tpc = triton.cdiv(tiles, sms * ctas)
+        self.nb = triton.cdiv(tiles, self.tpc)
+        self.nb_pow2 = triton.next_power_of_2(self.nb)
+        self.tp_pow2 = triton.next_power_of_2(tp)
