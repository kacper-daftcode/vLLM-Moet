+    """[vllm-moet r3] ``prepare_pos_seq_lens(...)`` then
+    ``combine_sampled_and_draft_tokens(...)`` (``seq_lens[:num_reqs_padded]`` is
+    what the latter reads) as one launch; returns ``logits_indices``."""
+    assert num_new_sampled_tokens in (0, 1), num_new_sampled_tokens
+    num_reqs = idx_mapping.shape[0]
+    num_speculative_steps = draft_tokens.shape[-1]
