+# [vllm-moet] OpenAI's ``developer`` role (Codex and other Responses-API clients send it in
+# ``input``; the chat API accepts it too) is not in encoding_k3's vocabulary (user / system /
+# tool / assistant: ``encoding_k3.build_chat_segments`` raises "Unknown message role" -> HTTP 400).
+# K3's single ``system`` role is the equivalent (Moonshot's own API has no developer role), so
+# developer messages are rendered as system messages; ``name``, content and the dynamic ``tools``
+# of the message are kept (``system`` + ``tools`` is K3's dynamic tool-declare message).
+_K3_ROLE_MAP = {"developer": "system"}
+
+
+def _normalize_k3_roles(
+    conversation: list[ConversationMessage],
+) -> list[ConversationMessage]:
+    """[vllm-moet] Map the roles encoding_k3 does not know onto K3's (``developer`` -> ``system``).
+
+    Returns a new list; caller-owned message dicts are not mutated.
+    """
+    normalized: list[ConversationMessage] = []
+    for message in conversation:
+        target = _K3_ROLE_MAP.get(message.get("role"))  # type: ignore[arg-type]
+        if target is not None:
+            message = cast(ConversationMessage, {**message, "role": target})
+        normalized.append(message)
+    return normalized
+
