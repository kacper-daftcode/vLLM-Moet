+def _launch(tier: str, K: int, desc: torch.Tensor, n_rows: int, pairs: int,
+            stream):
+    fn = _fns[(tier, K)]
+    args = [ctypes.c_uint64(desc.data_ptr()),
+            ctypes.c_uint32(K),
+            ctypes.c_uint32(K // 64),
+            ctypes.c_uint32(n_rows * 2),
