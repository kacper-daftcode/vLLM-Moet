+            _w2d = moe_w2_delta
+            _tp = get_tp_group()
+            # open this step's pin scope: slots touched by any pass below
+            # are ineligible for eviction until the next step_begin
+            _btier.step_begin()
+
+            def _max_miss_tp(local: int) -> int:
+                if _tp.world_size <= 1:
+                    return local
+                t = torch.tensor([local], device=_btier.dev)
+                torch.distributed.all_reduce(
+                    t, op=torch.distributed.ReduceOp.MAX,
+                    group=_tp.device_group)
+                return int(t.item())
