+    pre_trained_config["eagle_aux_hidden_state_layer_ids"] = aux_layer_ids
+    # DSpark indexes target layers as aux_id - 1 (matches the dense configs).
+    pre_trained_config["target_layer_ids"] = [i - 1 for i in aux_layer_ids]
