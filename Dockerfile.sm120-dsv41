# vLLM-Moet: DeepSeek-V4.1-Flash on SM120 (RTX PRO 6000 Blackwell / RTX 5090)
#
# Serving image = official vllm/vllm-openai:deepseekv41-flash-0909 (the tag the vLLM
# recipe pins for DeepSeek-V4.1-Flash on NVIDIA) with the SM120 kernel gaps closed:
#   1. FlashInfer 0.6.18 sparse-MLA SM120: instantiations for the DeepSeek-V4.1
#      geometry (SWA page 32, compressed page 128, SWA rows 1152/192) and a
#      page-size-aware dispatch hook (tools/dsv41_sm120/patch_flashinfer.py +
#      sparse_mla_sm120_dsv41.cu). The AOT sparse_mla_sm120.so is removed (it would
#      be loaded INSTEAD of the patched JIT sources) and the module is precompiled
#      into the JIT cache, so the first serve pays no JIT compile.
#   2. DeepGEMM 8b1392b9 (the pin vendored in the image): SM120 FP8 and MXFP4 paged MQA
#      logits accept the 128-row indexer pages of the compress_ratio=1 layers
#      (tools/dsv41_sm120/patch_deepgemm.py); _C is rebuilt INSIDE the official image
#      so the python/glibc/torch ABI matches by construction, like Dockerfile.sm120-v024.
#      vLLM's sm_10x-only gate on the MXFP4 indexer cache is lifted
#      (patch_vllm_indexer_fp4_sm120.py), so `--attention-config
#      '{"indexer_kv_dtype":"mxfp4"}'` (launcher: INDEXER_KV_DTYPE=mxfp4) stores 68 instead
#      of 132 B per indexer key; the default stays fp8.
#   3. Decode-shaped dense MXFP8 GEMMs (M <= 16 rows) run on the vLLM-Moet tensor-core
#      GEMV (tools/dsv41_sm120/sm120_gemv/) instead of the CUTLASS 128-row tile
#      (patch_vllm_mxfp8_gemv.py, one dispatch branch in
#      FlashInferCutlassMxfp8LinearKernel.apply_weights, VLLM_MOET_SM120_GEMV=0 reverts),
#      and the grouped o-projection `wo_a` keeps its MXFP8 weights and runs on the same
#      kernel for decode batches (<= 64 tokens) instead of vLLM's sm_120 fallback of
#      BF16 weights + cuBLAS bmm (patch_vllm_wo_a_sm120.py, VLLM_MOET_SM120_GEMV_BMM=0
#      reverts).
#   4. The prompt encoder's reasoning-effort tiers follow the released checkpoint
#      (low 50 / high 75 / max 100, default high) instead of the pre-release table vLLM
#      vendored (25 / 50 / 75 / 100): a thinking-mode request without an explicit effort
#      renders "Reasoning Effort: 75" as DeepSeek's own encoder does, not 50
#      (patch_vllm_reasoning_effort.py; verified byte-identical to the checkpoint's
#      encoding/encoding.py on its goldens by test_reasoning_effort_encoding.py).
#   5. The compressed (main) KV cache can be stored in the checkpoint's own FP4 record
#      (e2m1 + one e4m3 scale per 16 dims, 288 B/state instead of 584; launcher KV_RECORD=nvfp4,
#      the default since 2026-09-21): the insert kernel quantizes like inference/kernel.py's
#      fp4_act_quant (bit-exact), and the SM120 sparse-MLA kernels read an fp8_ds_mla scratch of the
#      attended states (decode: one gather per kv source x index set; prefill: the requests'
#      contexts dequantized once per kv source). 1.49M -> 3.06M KV tokens on 4x RTX PRO 6000,
#      GSM8K-200 / needle unchanged, -1 % decode, -3 % prefill (tools/dsv41_sm120/nvfp4_kv/,
#      patch_vllm_packed_kv_sm120.py; KV_RECORD=fp8_ds_mla restores today's record, no rebuild).
# These are the only vLLM-side changes. The model's page geometry stays identical to the
# datacenter (SM100) path; the kernels learned the shapes.
#
# Build (from the repo root):
#   DOCKER_BUILDKIT=1 docker build -f Dockerfile.sm120-dsv41 -t vllm-moet-sm120:dsv41-0909 .
#
# Serve (official checkpoint; 4x RTX PRO 6000, TP4, 512K context, DSpark k=5, vision on):
#   MODEL_DIR=/path/to/DeepSeek-V4.1-Flash CACHE_DIR=/path/to/cache docker/sm120/run-dsv41.sh
#   (GPUS=0,1,2,3 TP=4 PORT=8001 GPU_MEM_UTIL=0.94 MAX_MODEL_LEN=524288 by default; first start with
#    an empty CACHE_DIR: GPU_MEM_UTIL=0.92, the FlashInfer autotune sweep needs the headroom.)
#   Eight cards / 1M window:
#   GPUS=0,1,2,3,4,5,6,7 TP=8 MAX_MODEL_LEN=1048576 GPU_MEM_UTIL=0.90 MAX_NUM_SEQS=64 \
#   MAX_NUM_BATCHED_TOKENS=16384 MODEL_DIR=... CACHE_DIR=... docker/sm120/run-dsv41.sh
#   The launcher passes --tokenizer-mode/--reasoning-parser/--tool-call-parser deepseek_v41,
#   --kv-cache-dtype fp8 and the DSpark speculative config with enable_adaptive_verification=false
#   (must stay false: DeepseekV4IndexerBackend on this path does not support it - the same override
#   the vLLM recipe applies on AMD). Deploy guide: docs/sm120-deploy.md.
#
# Port notes, gap inventory and validation: docs/dsv41-sm120-port.md.

ARG BASE_IMAGE=vllm/vllm-openai:deepseekv41-flash-0909

# ---------------------------------------------------------------- deep_gemm
# The runtime image ships nvcc 13.0 + torch 2.13 + py3.12 for JIT, and the CUDA
# headers/libs live in the pip nvidia-cu13 wheels (no apt CUDA dev packages
# needed): CPATH for the headers, a symlink dir for the unversioned -lnvrtc.
FROM ${BASE_IMAGE} AS deepgemm-builder
ARG DEEPGEMM_REF=8b1392b978f5a03c828dd1711090d7fb50958b8a
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir --break-system-packages pybind11 wheel
RUN git clone https://github.com/deepseek-ai/DeepGEMM.git /deepgemm \
    && cd /deepgemm && git checkout "$DEEPGEMM_REF" \
    && git submodule update --init --depth 1 third-party/cutlass third-party/fmt
COPY tools/dsv41_sm120/patch_deepgemm.py /tmp/patch_deepgemm.py
RUN python3 /tmp/patch_deepgemm.py /deepgemm
RUN mkdir -p /tmp/linklibs \
    && ln -sf /usr/local/lib/python3.12/dist-packages/nvidia/cu13/lib/libnvrtc.so.13 /tmp/linklibs/libnvrtc.so \
    && ln -sf /usr/local/cuda/lib64/libcudart.so.13 /tmp/linklibs/libcudart.so \
    && cd /deepgemm \
    && CPATH=/usr/local/lib/python3.12/dist-packages/nvidia/cu13/include \
       LIBRARY_PATH=/tmp/linklibs \
       python3 setup.py build_ext --inplace \
    && ls -la /deepgemm/deep_gemm/_C.cpython-312-x86_64-linux-gnu.so

# ---------------------------------------------------------------- final image
FROM ${BASE_IMAGE}

# 1. DeepGEMM _C with the SM120 block_kv=128 paged MQA path (headers are unchanged,
#    so the vendored JIT device sources stay as shipped).
COPY --from=deepgemm-builder /deepgemm/deep_gemm/_C.cpython-312-x86_64-linux-gnu.so \
     /usr/local/lib/python3.12/dist-packages/vllm/third_party/deep_gemm/_C.cpython-312-x86_64-linux-gnu.so

# 2. FlashInfer DSV4.1 SM120 instantiations: patch the installed JIT sources, drop the
#    AOT artifact, precompile for the sm_120 family so no worker JIT-compiles at boot.
COPY tools/dsv41_sm120/ /opt/vllm-moet/dsv41_sm120/
RUN python3 /opt/vllm-moet/dsv41_sm120/patch_flashinfer.py \
    && rm -f /usr/local/lib/python3.12/dist-packages/flashinfer_jit_cache/jit_cache/sparse_mla_sm120/sparse_mla_sm120.so \
    && FLASHINFER_CUDA_ARCH_LIST=12.0f python3 -c \
       "from flashinfer.jit.mla import gen_sparse_mla_sm120_module; s = gen_sparse_mla_sm120_module(); s.build(verbose=False); assert s.jit_library_path.exists(), s.jit_library_path; print('precompiled', s.jit_library_path)" \
    && python3 -c "import vllm.third_party.deep_gemm as dg; print('deep_gemm', dg.__version__, dg._C.__file__)"

# 3. Decode-shaped dense MXFP8 GEMMs (M <= 16) go to the vLLM-Moet tensor-core GEMV
#    (tools/dsv41_sm120/sm120_gemv/, 2.3-3.7x faster than the CUTLASS 128-row tile at
#    M = 6 on RTX PRO 6000), and the grouped o-projection wo_a stays MXFP8 on the same
#    kernel (2.9x faster than the BF16-weight cuBLAS bmm fallback at 6 tokens, half the
#    weight bytes). The extension is compiled here so no worker JIT-builds it;
#    TORCH_EXTENSIONS_DIR must stay identical at run time for the cache to hit.
#    (patch_vllm_indexer_sm120.py is deliberately NOT applied: the DeepGEMM varlen
#    indexer path costs ~0.5 ms/step on sm_120 and adaptive verification was a net
#    loss in the 2026-09-18 measurements; see docs/dsv41-sm120-port.md.)
#    patch_vllm_moe_glue_sm120.py (2026-09-19): DeepGEMM MoE glue kernels at decode token
#    counts -- ep_scatter per (token, expert) pair, unrolled ep_gather, silu*up+quant
#    skipping the 64-row padding -- bit-exact, ~5 us per layer. Until the image is rebuilt
#    the serving host bind-mounts the same three patched files (run.sh GLUE_PATCH=1).
#    patch_vllm_reasoning_effort.py (2026-09-20): official reasoning-effort tiers in the
#    deepseek_v41 prompt encoder (see header, item 4); the test that follows asserts the
#    default thinking-mode request renders budget 75 and fails the build otherwise.
#    patch_vllm_indexer_fp4_sm120.py (2026-09-20): dsa_indexer_uses_fp4 admits sm_120 (header,
#    item 2); a gate only -- the indexer cache format is still chosen per launch.
#    nvfp4_kv/patch_vllm_packed_kv_sm120.py (2026-09-21): packed compressed-KV records (header,
#    item 5); inert unless VLLM_MOET_KV_RECORD selects nvfp4 / fp8_v41 at launch.
ENV TORCH_EXTENSIONS_DIR=/opt/vllm-moet/torch_extensions
RUN python3 /opt/vllm-moet/dsv41_sm120/patch_vllm_mxfp8_gemv.py \
    && python3 /opt/vllm-moet/dsv41_sm120/patch_vllm_wo_a_sm120.py \
    && python3 /opt/vllm-moet/dsv41_sm120/patch_vllm_moe_glue_sm120.py \
    && python3 /opt/vllm-moet/dsv41_sm120/patch_vllm_reasoning_effort.py \
    && python3 /opt/vllm-moet/dsv41_sm120/patch_vllm_indexer_fp4_sm120.py \
    && python3 /opt/vllm-moet/dsv41_sm120/nvfp4_kv/patch_vllm_packed_kv_sm120.py \
    && python3 /opt/vllm-moet/dsv41_sm120/test_reasoning_effort_encoding.py \
    && python3 -c "import sys; sys.path.insert(0, '/opt/vllm-moet/dsv41_sm120/sm120_gemv'); import mxfp8_gemv_sm120 as g; e = g._ext(); assert hasattr(e, 'mxfp8_gemv_grouped'); print('sm120 gemv extension built')" \
    && ls /opt/vllm-moet/torch_extensions/vllm_moet_mxfp8_gemv_sm120/*.so

LABEL org.opencontainers.image.title="vLLM-Moet DeepSeek-V4.1-Flash SM120" \
      org.opencontainers.image.description="vllm/vllm-openai:deepseekv41-flash-0909 + DSV4.1 SM120 sparse-MLA instantiations (FlashInfer) + DeepGEMM 128-row paged MQA logits on sm_120 (FP8 and MXFP4 indexer cache) + FP4 (nvfp4) compressed KV record + MXFP8 decode GEMV + official reasoning-effort tiers"
